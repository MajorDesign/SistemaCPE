# =========================================
# CPE Control Bot — Configuracao
# =========================================
# Copie para `.env` (nao versionado) e preencha.
#
# NUNCA commita o .env real. Se o token vazar, resetar no Discord
# Developer Portal (Bot > Reset Token) — o antigo morre na hora.

# Token do bot Discord — obter em https://discord.com/developers/applications
# > CPE Control > Bot > Reset Token (mostra 1 vez, copiar imediatamente)
DISCORD_BOT_TOKEN=

# ID do servidor Discord da CPE (Modo Desenvolvedor > botao direito no
# icone do servidor > Copiar ID do servidor)
DISCORD_GUILD_ID=1218275609382359050

# Chave secreta compartilhada com o CPEControlAPI. DEVE ser identica ao
# valor de DISCORD_BOT_API_KEY em server/.env. Ver .discord-bot-key.txt
# no CPEDC22 pra copiar o valor gerado.
DISCORD_BOT_API_KEY=

# URL base da CPEControlAPI. Bot roda no mesmo host, entao localhost basta.
CPE_API_BASE=http://127.0.0.1:8000
