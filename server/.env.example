# ============================================================
# CPE Control API — exemplo de configuração
# Copie para `.env` e preencha os valores reais. NUNCA commitar `.env`.
# ============================================================

# BANCO DE DADOS
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=cpe_plus
MYSQL_USER=root
MYSQL_PASSWORD=

DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cpe_plus?charset=utf8mb4

# APP_SECRET — chave HMAC dos tokens de sessão. MUITO IMPORTANTE.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 caracteres. Se ficar vazio ou default, a API recusa subir.
APP_SECRET=

# Sessão expira após N segundos (padrão: 12h = 43200)
SESSION_MAX_AGE_SECONDS=43200

# Cookie HTTPS-only. Deixe 0 enquanto roda em HTTP, troque para 1 quando subir SSL.
COOKIE_SECURE=0

# CORS — separe por vírgula
# Em produção atrás de Cloudflare Tunnel, adicionar o domínio público:
#   CORS_ORIGINS=https://cpecontrol.us.kg,https://api.cpecontrol.us.kg
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5500,http://localhost:8000

# Chave do agente de inventário (deve bater com tools/inventory_agent/agent.py)
INVENTORY_AGENT_KEY=

# Rastreamento de encomendas
SEURASTREIO_API_KEY=

# Agenda Carbonio
CARBONIO_URL=
AGENDA_SECRET_KEY=

# Clicksign
CLICKSIGN_TOKEN=
CLICKSIGN_ENV=sandbox

# Omada Controller
OMADA_BASE_URL=
OMADA_USER=
OMADA_PASS=
OMADA_SITE=

# Mikrotik
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_PORT=8728

# SMTP — Carbonio (e-mails de tickets, geral)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CPE Control
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# SMTP — Conta dedicada do modulo Equipe de Suporte (agendamento)
# Se nao definido, cai no SMTP_* acima. Aqui usamos conta separada
# (suporte.agenda.cpe@cpetecnologia.com.br) para nao misturar com tickets.
AGENDA_SMTP_HOST=mail.cpetecnologia.com.br
AGENDA_SMTP_PORT=587
AGENDA_SMTP_USER=suporte.agenda.cpe@cpetecnologia.com.br
AGENDA_SMTP_PASSWORD=
AGENDA_SMTP_FROM=suporte.agenda.cpe@cpetecnologia.com.br
AGENDA_SMTP_FROM_NAME=CPE Tecnologia - Agendamento
AGENDA_SMTP_USE_TLS=1
AGENDA_SMTP_USE_SSL=0

# E-mails internos da equipe que recebem alerta de novo agendamento pendente
# (separados por virgula). Se vazio, cai no AGENDA_SMTP_USER acima (auto-envio).
EQUIPE_AGENDA_EMAILS=suporte.agenda.cpe@cpetecnologia.com.br

# ─── Cloudflare Realtime TURN ───────────────────────────────────────
# Gera credentials TURN efêmeros pra reuniões WebRTC funcionarem com
# usuários atrás de NAT corporativo / fora do país.
# Como obter:
#   1. dash.cloudflare.com -> Realtime -> TURN -> Create TURN App
#   2. Copia o "Token Key ID" e o "Token Key Secret" mostrados 1 vez
#   3. Cola aqui e reinicia o CPEControlAPI
# Sem essas vars, fallback automático pra STUN-only (= comportamento legado).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=

# Hot reload do uvicorn — só em DEV. NUNCA em prod (NSSM service):
# o reload spawna worker com Python errado e quebra registro de routers.
UVICORN_RELOAD=0

# DEV (deixe vazio em produção)
DEV_API_KEY=
